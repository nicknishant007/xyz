APP_NAME=Gmail AI Mail Manager
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
COOKIE_SECURE=false

MOCK_INTEGRATIONS=true
MOCK_AI=false
MOCK_GMAIL_API_URL=http://localhost:8000/mock/gmail
MOCK_AI_API_URL=http://localhost:8000/mock/ai
GOOGLE_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
GOOGLE_OAUTH_BASE_URL=https://accounts.google.com
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

DATABASE_URL=sqlite:///./mail_manager.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_CONCURRENCY=5
SYNC_MAX_THREADS=200
SESSION_SECRET=change-this-development-secret
